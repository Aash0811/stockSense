generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
  AUDITOR
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
  ARCHIVED
}

enum TrackingType {
  NONE
  BATCH
  SERIAL
}

enum LocationType {
  WAREHOUSE
  ZONE
  AISLE
  RACK
  SHELF
  BIN
}

enum MovementType {
  RECEIPT
  DELIVERY
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  RETURN
  WRITE_OFF
  RESERVATION
  RESERVATION_RELEASE
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum DeliveryStatus {
  DRAFT
  READY
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  CANCELED
}

// ============================================================
// USER
// ============================================================

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
  role         Role    @default(WAREHOUSE_STAFF)
  isActive     Boolean @default(true)

  stockMovements StockMovement[]
  createdPOs     PurchaseOrder[] @relation("PurchaseOrderCreator")
  stockAdjustments StockAdjustment[]
  passwordResetTokens PasswordResetToken[]
  loginOtpTokens      LoginOtpToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

model PasswordResetToken {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginOtpToken {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id          String  @id @default(uuid())
  name        String
  sku         String  @unique
  description String?
  brand       String?
  barcode     String? @unique

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  status       ProductStatus @default(ACTIVE)
  trackingType TrackingType  @default(NONE)

  unitName String @default("piece")

  minimumStock Int @default(0)
  safetyStock  Int @default(0)
  leadTimeDays Int @default(0)
  reorderPoint Int @default(0)

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([name])
}

// ============================================================
// PRODUCT VARIANT
// ============================================================

model ProductVariant {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  name    String
  sku     String  @unique
  barcode String? @unique

  price Decimal @db.Decimal(12, 2)
  cost  Decimal @db.Decimal(12, 2)

  isActive Boolean @default(true)

  inventory      Inventory[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseOrderItem[]
  receiptItems   ReceiptItem[]
  deliveryItems  DeliveryItem[]
  transferItems  TransferItem[]
  reservations   Reservation[]
  stockAdjustments StockAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}

// ============================================================
// WAREHOUSE
// ============================================================

model Warehouse {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  address  String?
  city     String?
  state    String?
  country  String  @default("India")
  isActive Boolean @default(true)

  locations Location[]
  inventory Inventory[]

  stockMovements StockMovement[]

  purchaseOrders PurchaseOrder[]
  receipts       Receipt[]
  deliveries     Delivery[]

  sourceTransfers      Transfer[] @relation("SourceWarehouse")
  destinationTransfers Transfer[] @relation("DestinationWarehouse")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([city])
}

// ============================================================
// LOCATION
// ============================================================

model Location {
  id String @id @default(uuid())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  parentId String?
  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children Location[] @relation("LocationHierarchy")
  deliveryItems DeliveryItem[]
  sourceTransferItems TransferItem[] @relation("SourceTransferLocation")
  destinationTransferItems TransferItem[] @relation("DestinationTransferLocation")
  stockAdjustments StockAdjustment[]

  name String
  code String

  type     LocationType
  isActive Boolean      @default(true)

  inventory Inventory[]

  stockMovements StockMovement[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  receiptItems ReceiptItem[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([parentId])
  @@index([type])
}

// ============================================================
// INVENTORY
// ============================================================

model Inventory {
  id String @id @default(uuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  onHand    Int @default(0)
  reserved  Int @default(0)
  damaged   Int @default(0)
  inTransit Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([variantId, locationId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([locationId])
}

// ============================================================
// STOCK MOVEMENT LEDGER
// ============================================================

model StockMovement {
  id String @id @default(uuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  type     MovementType
  quantity Int

  referenceType String?
  referenceId   String?

  reason String?

  idempotencyKey String? @unique

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

// ============================================================
// SUPPLIER
// ============================================================

model Supplier {
  id String @id @default(uuid())

  name    String
  contact String?
  email   String?
  phone   String?
  address String?

  leadTimeDays Int @default(0)

  purchaseOrders PurchaseOrder[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

// ============================================================
// PURCHASE ORDER
// ============================================================

model PurchaseOrder {
  id String @id @default(uuid())

  orderNumber String @unique

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  createdById String
  createdBy   User   @relation("PurchaseOrderCreator", fields: [createdById], references: [id])

  status PurchaseOrderStatus @default(DRAFT)

  expectedDate DateTime?

  notes String?

  items    PurchaseOrderItem[]
  receipts Receipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@index([expectedDate])
}

// ============================================================
// PURCHASE ORDER ITEM
// ============================================================

model PurchaseOrderItem {
  id String @id @default(uuid())

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  orderedQuantity  Int
  receivedQuantity Int @default(0)

  unitCost Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([variantId])
}

// ============================================================
// RECEIPT
// ============================================================

model Receipt {
  id String @id @default(uuid())

  receiptNumber String @unique

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status String @default("DRAFT")

  expectedQuantity Int @default(0)
  receivedQuantity Int @default(0)
  damagedQuantity  Int @default(0)

  items ReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@index([status])
}

// ============================================================
// RECEIPT ITEM
// ============================================================

model ReceiptItem {
  id String @id @default(uuid())

  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity        Int
  damagedQuantity Int @default(0)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  createdAt DateTime @default(now())

  @@index([receiptId])
  @@index([variantId])
}

// ============================================================
// DELIVERY
// ============================================================

model Delivery {
  id String @id @default(uuid())

  deliveryNumber String @unique

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status DeliveryStatus @default(DRAFT)

  items DeliveryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
  @@index([status])
}

// ============================================================
// DELIVERY ITEM
// ============================================================

model DeliveryItem {
  id String @id @default(uuid())

  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  orderedQuantity   Int
  deliveredQuantity Int @default(0)

  createdAt DateTime @default(now())

  @@index([deliveryId])
  @@index([variantId])
  @@index([locationId])
}

// ============================================================
// TRANSFER
// ============================================================

model Transfer {
  id String @id @default(uuid())

  transferNumber String @unique

  sourceWarehouseId String
  sourceWarehouse   Warehouse @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])

  destinationWarehouseId String
  destinationWarehouse   Warehouse @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])

  status String @default("DRAFT")

  items TransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
}

// ============================================================
// TRANSFER ITEM
// ============================================================

model TransferItem {
  id String @id @default(uuid())

  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  sourceLocationId String
  sourceLocation   Location @relation("SourceTransferLocation", fields: [sourceLocationId], references: [id])

  destinationLocationId String
  destinationLocation   Location @relation("DestinationTransferLocation", fields: [destinationLocationId], references: [id])

  quantity         Int
  receivedQuantity Int @default(0)

  createdAt DateTime @default(now())

  @@index([transferId])
  @@index([variantId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
}

// ============================================================
// RESERVATION
// ============================================================

model Reservation {
  id String @id @default(uuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  warehouseId String
  locationId  String?

  quantity Int

  referenceType String?
  referenceId   String?

  status String @default("ACTIVE")

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId])
  @@index([warehouseId])
  @@index([status])
  @@index([expiresAt])
}

// ============================================================
// STOCK ADJUSTMENT
// ============================================================

model StockAdjustment {
  id String @id @default(uuid())

  adjustmentNumber String @unique

  reason String
  status String @default("PENDING")

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  systemQuantity Int
  countedQuantity Int
  difference Int

  createdById String
  createdBy User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([variantId])
  @@index([locationId])
  @@index([status])
}
